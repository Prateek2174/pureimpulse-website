---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Contact" description="Get in touch with PureImpulse Studios.">

  <section class="max-w-4xl mx-auto px-6 py-24">
    <p class="font-display text-xs tracking-[0.4em] uppercase text-amber-500/70 mb-4">Reach Out</p>
    <h1 class="font-display text-5xl font-semibold text-stone-100 mb-6">Contact</h1>
    <p class="text-stone-500 mb-16 max-w-xl leading-relaxed">
      Whether you have a press inquiry, want to collaborate, or just want to say something about the project — we'd love to hear from you.
    </p>

    <div class="grid md:grid-cols-2 gap-16">

      <!-- Contact form -->
      <div>
        <form class="flex flex-col gap-6" name="contact" method="POST" data-netlify="true">
          <div>
            <label class="block text-xs tracking-widest uppercase text-stone-500 mb-2 font-display">Name</label>
            <input type="text" name="name" required
              class="w-full bg-stone-900 border border-stone-800 focus:border-amber-700 text-stone-200 px-4 py-3 text-sm outline-none transition-colors placeholder-stone-700"
              placeholder="Your name" />
          </div>
          <div>
            <label class="block text-xs tracking-widest uppercase text-stone-500 mb-2 font-display">Email</label>
            <input type="email" name="email" required
              class="w-full bg-stone-900 border border-stone-800 focus:border-amber-700 text-stone-200 px-4 py-3 text-sm outline-none transition-colors placeholder-stone-700"
              placeholder="your@email.com" />
          </div>
          <div>
            <label class="block text-xs tracking-widest uppercase text-stone-500 mb-2 font-display">Subject</label>
            <select name="subject"
              class="w-full bg-stone-900 border border-stone-800 focus:border-amber-700 text-stone-200 px-4 py-3 text-sm outline-none transition-colors">
              <option value="general">General Inquiry</option>
              <option value="press">Press / Media</option>
              <option value="collaboration">Collaboration</option>
              <option value="feedback">Feedback</option>
            </select>
          </div>
          <div>
            <label class="block text-xs tracking-widest uppercase text-stone-500 mb-2 font-display">Message</label>
            <textarea name="message" required rows="5"
              class="w-full bg-stone-900 border border-stone-800 focus:border-amber-700 text-stone-200 px-4 py-3 text-sm outline-none transition-colors placeholder-stone-700 resize-none"
              placeholder="What's on your mind?"></textarea>
          </div>
          <button type="submit"
            class="px-8 py-3 bg-amber-600 hover:bg-amber-500 text-stone-950 font-semibold tracking-widest text-sm uppercase transition-colors self-start">
            Send Message
          </button>
        </form>
      </div>

      <!-- Contact info -->
      <div class="flex flex-col gap-8">
        <div>
          <p class="font-display text-xs tracking-[0.4em] uppercase text-amber-500/70 mb-4">Find Us</p>
          <div class="flex flex-col gap-4">
            <a href="https://www.reddit.com/r/pureimpulsestudios" target="_blank" rel="noopener"
              class="flex items-center gap-3 text-stone-400 hover:text-amber-400 transition-colors group">
              <div class="w-8 h-8 border border-stone-800 group-hover:border-amber-800 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
              </div>
              <span class="text-sm">Reddit — r/pureimpulsestudios</span>
            </a>
            <a href="mailto:pureimpulsestudios@gmail.com"
              class="flex items-center gap-3 text-stone-400 hover:text-amber-400 transition-colors group">
              <div class="w-8 h-8 border border-stone-800 group-hover:border-amber-800 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              </div>
              <span class="text-sm">pureimpulsestudios@gmail.com</span>
            </a>
          </div>
        </div>

        <div class="border-t border-stone-800 pt-8">
          <p class="text-stone-600 text-sm leading-relaxed">
            We're a small indie studio — response times may vary, but we read every message. For press inquiries, please include your outlet and deadline.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
