---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Home" description="PureImpulse Studios — indie game studio crafting story-driven RPG experiences.">

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-stone-950 via-stone-900 to-stone-950"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_#7c2d1220_0%,_transparent_70%)]"></div>

    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
      <div class="mb-12 inline-block">
        <div class="border border-amber-700/60 px-8 py-4 relative">
          <div class="absolute -top-px left-4 right-4 h-px bg-amber-500/40"></div>
          <div class="absolute -bottom-px left-4 right-4 h-px bg-amber-500/40"></div>
          <p class="font-display text-xs tracking-[0.4em] uppercase text-amber-500/70 mb-1">PureImpulse Studios</p>
          <p class="font-display text-xs tracking-[0.2em] uppercase text-stone-600">presents</p>
        </div>
      </div>

      <h1 class="font-display text-6xl md:text-8xl font-bold tracking-wider text-stone-100 mb-4 leading-none">
        Twilight<br/><span class="text-amber-400">Rites</span>
      </h1>
      <p class="text-stone-400 text-lg md:text-xl font-light tracking-wide max-w-2xl mx-auto mb-10">
        The moon has shattered, and the world plunges into chaos and night eternal. Weaponize the powers of a fallen pantheon — and hold back the darkness threatening oblivion.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/games" class="px-8 py-3 bg-amber-600 hover:bg-amber-500 text-stone-950 font-semibold tracking-widest text-sm uppercase transition-colors">
          Explore the Game
        </a>
        <a href="/devlog" class="px-8 py-3 border border-stone-700 hover:border-amber-700 text-stone-400 hover:text-amber-400 text-sm tracking-widest uppercase transition-colors">
          Follow Development
        </a>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-stone-600 text-xs tracking-widest uppercase">
      <span>Scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-stone-600 to-transparent"></div>
    </div>
  </section>

  <!-- Game teaser -->
  <section class="max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-16 items-center">
    <div>
      <p class="font-display text-xs tracking-[0.4em] uppercase text-amber-500/70 mb-4">Current Project</p>
      <h2 class="font-display text-4xl font-semibold text-stone-100 mb-6 leading-tight">Twilight Rites</h2>
      <p class="text-stone-400 leading-relaxed mb-4">
        The moon has shattered and from the abyss reigns darkness eternal. The Shadowborne invade to ravage against life and feast on the moonlight inherent within humanity. You play as Lucian Sov — a Moonwoken who lost his home, now wielding a power that borders on heresy.
      </p>
      <p class="text-stone-500 leading-relaxed mb-8">
        A dark fantasy turn-based action RPG built in Unreal Engine 5. Journey across shadow-touched lands with powerful companions, unravel eldritch mysteries, and decide the fate of life itself.
      </p>
      <a href="/games" class="inline-flex items-center gap-2 text-amber-400 hover:text-amber-300 text-sm tracking-wide uppercase transition-colors">
        Learn more <span>&rarr;</span>
      </a>
    </div>
    <div class="aspect-video bg-stone-900 border border-stone-800 flex items-center justify-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_#7c2d1215_0%,_transparent_70%)]"></div>
      <div class="text-center">
        <p class="font-display text-stone-700 text-sm tracking-widest uppercase">Game Art</p>
        <p class="text-stone-800 text-xs mt-1">Coming soon</p>
      </div>
    </div>
  </section>

  <!-- Studio strip -->
  <section class="border-y border-stone-800/60 py-16 bg-stone-900/30">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <p class="font-display text-xs tracking-[0.4em] uppercase text-amber-500/70 mb-4">The Studio</p>
      <h2 class="font-display text-3xl text-stone-200 mb-4">PureImpulse Studios</h2>
      <p class="text-stone-500 max-w-xl mx-auto leading-relaxed">
        A solo indie studio building story-driven RPG experiences. Every detail crafted with intent — from combat mechanics to world atmosphere.
      </p>
      <a href="/about" class="inline-flex items-center gap-2 mt-6 text-amber-400 hover:text-amber-300 text-sm tracking-wide uppercase transition-colors">
        About the studio <span>&rarr;</span>
      </a>
    </div>
  </section>

  <!-- Latest devlog -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="font-display text-xs tracking-[0.4em] uppercase text-amber-500/70 mb-2">Latest Updates</p>
        <h2 class="font-display text-3xl text-stone-200">Devlog</h2>
      </div>
      <a href="/devlog" class="text-amber-400 hover:text-amber-300 text-sm tracking-wide uppercase transition-colors">All posts &rarr;</a>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {[
        { title: 'Combat System Foundation', date: 'May 2025', excerpt: 'Building the core combat state machine — how exploration transitions into turn-based battle.' },
        { title: 'World & Atmosphere', date: 'Apr 2025', excerpt: 'Early thoughts on tone, visual direction, and what makes Twilight Rites feel distinct.' },
        { title: 'Why Expedition 33 Inspired Us', date: 'Mar 2025', excerpt: 'The game that sparked this project and the design pillars we are taking forward.' },
      ].map(post => (
        <article class="border border-stone-800 hover:border-amber-800/60 transition-colors p-6 group">
          <p class="text-stone-600 text-xs tracking-wide uppercase mb-3">{post.date}</p>
          <h3 class="font-display text-stone-200 text-lg mb-3 group-hover:text-amber-400 transition-colors leading-snug">{post.title}</h3>
          <p class="text-stone-500 text-sm leading-relaxed">{post.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

</Layout>
