---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Home" description="PureImpulse Studios — indie game studio crafting story-driven RPG experiences.">

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Deep night sky atmosphere -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 40%, #0d0f2a 0%, #06080f 70%);"></div>
    <!-- Subtle violet nebula -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 30% 60%, #1a0a3a18 0%, transparent 60%), radial-gradient(ellipse at 70% 30%, #0a1a3a15 0%, transparent 50%);"></div>
    <!-- Star-like dots via gradient -->
    <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(1px 1px at 20% 30%, #a8bde040, transparent), radial-gradient(1px 1px at 80% 10%, #a8bde030, transparent), radial-gradient(1px 1px at 50% 80%, #a8bde025, transparent), radial-gradient(1px 1px at 10% 70%, #a8bde020, transparent), radial-gradient(1px 1px at 90% 60%, #a8bde035, transparent);"></div>

    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
      <!-- Studio tag -->
      <div class="mb-10 inline-block">
        <div class="border border-slate-700/50 px-8 py-3 relative">
          <div class="absolute -top-px left-4 right-4 h-px bg-slate-500/30"></div>
          <div class="absolute -bottom-px left-4 right-4 h-px bg-slate-500/30"></div>
          <p class="font-display text-xs tracking-[0.4em] uppercase text-slate-500 mb-0.5">PureImpulse Studios</p>
          <p class="font-display text-xs tracking-[0.2em] uppercase text-slate-700">presents</p>
        </div>
      </div>

      <!-- Game title image -->
      <div class="mb-8 w-full overflow-hidden" style="height: 160px;">
        <img
          src="/TR_CurrentGameTitle_V2.png"
          alt="Twilight Rites"
          class="title-img-blend w-full h-auto"
          style="margin-top: -18%; transform: scale(1.1);"
        />
      </div>

      <p class="text-slate-400 text-lg md:text-xl font-light tracking-wide max-w-2xl mx-auto mb-10 leading-relaxed">
        The moon has shattered, and from the abyss reigns darkness eternal. Wield powers that border on heresy — and decide the fate of life itself.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/games" class="px-8 py-3 border border-slate-300/80 hover:bg-slate-300/10 text-slate-200 font-display font-semibold tracking-widest text-xs uppercase transition-colors">
          Explore the Game
        </a>
        <a href="/devlog" class="px-8 py-3 border border-slate-700 hover:border-slate-500 text-slate-500 hover:text-slate-300 text-xs tracking-widest font-display uppercase transition-colors">
          Follow Development
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-700 text-xs tracking-widest uppercase font-display">
      <span>Scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-slate-700 to-transparent"></div>
    </div>
  </section>

  <!-- Game teaser -->
  <section class="max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-16 items-center">
    <div>
      <p class="font-display text-xs tracking-[0.4em] uppercase text-slate-600 mb-4">Current Project</p>
      <h2 class="font-display text-4xl font-semibold text-slate-100 mb-6 leading-tight">Twilight Rites</h2>
      <p class="text-slate-400 leading-relaxed mb-4">
        The moon has shattered and from the abyss reigns darkness eternal. The Shadowborne invade to ravage against life and feast on the moonlight inherent within humanity. You play as Lucian Sov — a Moonwoken who lost his home, now wielding a power that borders on heresy.
      </p>
      <p class="text-slate-600 leading-relaxed mb-8">
        A dark fantasy turn-based action RPG built in Unreal Engine 5. Journey across shadow-touched lands with powerful companions, unravel eldritch mysteries, and decide the fate of life itself.
      </p>
      <a href="/games" class="inline-flex items-center gap-2 text-slate-400 hover:text-slate-200 text-xs tracking-widest font-display uppercase transition-colors border-b border-slate-700 hover:border-slate-400 pb-0.5">
        Learn more <span>&rarr;</span>
      </a>
    </div>
    <div class="aspect-video border border-slate-800 flex items-center justify-center relative overflow-hidden" style="background: radial-gradient(ellipse at center, #0d0f2a 0%, #06080f 100%);">
      <p class="font-display text-slate-800 text-sm tracking-widest uppercase">Key Art — Coming Soon</p>
    </div>
  </section>

  <!-- Studio strip -->
  <section class="border-y border-slate-800/50 py-16" style="background-color:#080a14;">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <p class="font-display text-xs tracking-[0.4em] uppercase text-slate-600 mb-4">The Studio</p>
      <h2 class="font-display text-3xl text-slate-200 mb-4">PureImpulse Studios</h2>
      <p class="text-slate-600 max-w-xl mx-auto leading-relaxed">
        A solo indie studio building story-driven RPG experiences. Every detail crafted with intent — from combat mechanics to world atmosphere.
      </p>
      <a href="/about" class="inline-flex items-center gap-2 mt-6 text-slate-500 hover:text-slate-300 text-xs tracking-widest font-display uppercase transition-colors">
        About the studio <span>&rarr;</span>
      </a>
    </div>
  </section>

  <!-- Latest devlog -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="font-display text-xs tracking-[0.4em] uppercase text-slate-600 mb-2">Latest Updates</p>
        <h2 class="font-display text-3xl text-slate-200">Devlog</h2>
      </div>
      <a href="/devlog" class="text-slate-500 hover:text-slate-300 text-xs tracking-widest font-display uppercase transition-colors">All posts &rarr;</a>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {[
        { title: 'Combat System Foundation', date: 'May 2025', excerpt: 'Building the core combat state machine — how exploration transitions into turn-based battle.' },
        { title: 'World & Atmosphere', date: 'Apr 2025', excerpt: 'Early thoughts on tone, visual direction, and what makes Twilight Rites feel distinct.' },
        { title: 'Why Expedition 33 Inspired Us', date: 'Mar 2025', excerpt: 'The game that sparked this project and the design pillars we are taking forward.' },
      ].map(post => (
        <article class="border border-slate-800 hover:border-slate-600 transition-colors p-6 group" style="background-color:#080a14;">
          <p class="text-slate-700 text-xs tracking-wide uppercase font-display mb-3">{post.date}</p>
          <h3 class="font-display text-slate-300 text-lg mb-3 group-hover:text-white transition-colors leading-snug">{post.title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{post.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

</Layout>
