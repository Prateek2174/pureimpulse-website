---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const { title = 'PureImpulse Studios', description = 'Indie game studio crafting story-driven experiences.' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | PureImpulse Studios</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-950 text-stone-200 font-sans min-h-screen">

    <!-- Nav -->
    <nav class="fixed top-0 left-0 right-0 z-50 border-b border-stone-800/60 bg-stone-950/80 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">
        <a href="/" class="flex items-center">
          <img src="/logo.png" alt="PureImpulse Studios" class="h-10 w-auto opacity-80 hover:opacity-100 transition-opacity" />
        </a>
        <div class="hidden md:flex items-center gap-8 text-sm tracking-wide">
          <a href="/" class="text-stone-400 hover:text-stone-100 transition-colors">Home</a>
          <a href="/games" class="text-stone-400 hover:text-stone-100 transition-colors">Games</a>
          <a href="/devlog" class="text-stone-400 hover:text-stone-100 transition-colors">Devlog</a>
          <a href="/about" class="text-stone-400 hover:text-stone-100 transition-colors">About</a>
          <a href="/contact" class="text-stone-400 hover:text-stone-100 transition-colors">Contact</a>
        </div>
        <!-- Mobile menu toggle (simple) -->
        <button id="menu-btn" class="md:hidden text-stone-400 hover:text-stone-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden px-6 pb-4 flex flex-col gap-4 text-sm">
        <a href="/" class="text-stone-400 hover:text-stone-100 transition-colors">Home</a>
        <a href="/games" class="text-stone-400 hover:text-stone-100 transition-colors">Games</a>
        <a href="/devlog" class="text-stone-400 hover:text-stone-100 transition-colors">Devlog</a>
        <a href="/about" class="text-stone-400 hover:text-stone-100 transition-colors">About</a>
        <a href="/contact" class="text-stone-400 hover:text-stone-100 transition-colors">Contact</a>
      </div>
    </nav>

    <main class="pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-800/60 mt-24 py-10 text-center text-stone-600 text-sm">
      <p class="font-display tracking-widest uppercase text-stone-500 mb-2">PureImpulse Studios</p>
      <p>&copy; {new Date().getFullYear()} PureImpulse Studios. All rights reserved.</p>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn')
      const menu = document.getElementById('mobile-menu')
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'))
    </script>
  </body>
</html>
